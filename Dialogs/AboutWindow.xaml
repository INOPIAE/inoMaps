<Window x:Class="Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über inoMaps"
        Height="400"
        Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">

            <Image x:Name="imgLogo"
                   Width="96"
                   Height="96"
                   Margin="0,0,20,0"/>

            <StackPanel>

                <TextBlock Text="inoMaps"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock x:Name="txtVersion"
                           FontSize="14"
                           Margin="0,10,0,0"/>

                <TextBlock Text="Historische Karten und Ortsdaten"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </StackPanel>

        <TextBox Grid.Row="1"
                 Margin="0,20,0,20"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto">

            inoMaps

Werkzeug zur Georeferenzierung historischer Karten
sowie zur Auswertung genealogischer Ortsdaten.

© 2026 Marcus Mängel

Alle Rechte vorbehalten.

Verwendete Technologien:
- .NET 9
- WPF
- JSON
        </TextBox>

        <Button Grid.Row="2"
                Content="Schließen"
                Width="100"
                HorizontalAlignment="Right"
                Click="Close_Click"/>

    </Grid>

</Window>