<Window x:Class="Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über inoMaps"
        Height="470"
        Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">

            <Image x:Name="imgLogo"
                   Width="96"
                   Height="96"
                   Margin="0,0,20,0"/>

            <StackPanel>

                <TextBlock Text="inoMaps"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock x:Name="txtVersion"
                           FontSize="14"
                           Margin="0,10,0,0"/>

                <TextBlock Text="Historische Karten und Ortsdaten"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </StackPanel>

        <TextBox x:Name="txtAbout"
                 Grid.Row="1"
                 Margin="0,20,0,10"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="2"
                    Margin="0,0,0,10">
            <Run Text="Quellcode verfügbar unter:"/>
            <Hyperlink NavigateUri="https://github.com/INOPIAE/inoMaps"
                       RequestNavigate="Hyperlink_RequestNavigate">
                https://github.com/INOPIAE/inoMaps
            </Hyperlink>
        </TextBlock>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="AGPL 3.0"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="ShowLicense_Click"/>

            <Button Content="Schließen"
                    Width="100"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>