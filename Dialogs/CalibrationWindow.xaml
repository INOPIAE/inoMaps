<Window x:Class="Dialogs.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kartenkalibrierung"
        Height="900"
        Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->

        <ToolBar Grid.Row="0">

            <Button Name="btnZoomIn"
                    Content="Zoom +"
                    Width="80"
                    Click="ZoomIn_Click"/>

            <Button Name="btnZoomOut"
                    Content="Zoom -"
                    Width="80"
                    Click="ZoomOut_Click"/>

            <Separator/>

            <Button Name="btnSave"
                    Content="Kalibrierung speichern"
                    Width="150"
                    Click="SaveCalibration_Click"/>

            <Separator/>

            <TextBlock Name="txtStep"
                       FontWeight="Bold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

        </ToolBar>

        <!-- Scrollbarer Kartenbereich -->

        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1">

            <ScrollViewer Name="MapScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          PanningMode="Both">

                <Canvas Name="MapCanvas"
                        Background="Transparent">

                    <Image x:Name="imgMap"
                           Stretch="None"
                           Cursor="Cross"
                           MouseMove="imgMap_MouseMove"
                           MouseLeftButtonDown="imgMap_MouseLeftButtonDown">

                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform"
                                            ScaleX="1"
                                            ScaleY="1"/>
                        </Image.LayoutTransform>

                    </Image>

                </Canvas>

            </ScrollViewer>

        </Border>

        <!-- Statusbereich -->

        <StatusBar Grid.Row="2">

            <StatusBarItem>
                <TextBlock Text="Maus:"/>
            </StatusBarItem>

            <StatusBarItem>
                <TextBlock Name="txtMousePosition"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="Zoom:"/>
            </StatusBarItem>

            <StatusBarItem>
                <TextBlock Name="txtZoom"
                           Text="100 %"/>
            </StatusBarItem>

        </StatusBar>

    </Grid>

</Window>