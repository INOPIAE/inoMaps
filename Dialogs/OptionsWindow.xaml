<Window x:Class="Dialogs.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optionen"
        Height="420"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Anzeige"
                  Grid.Row="0">

            <StackPanel Margin="10">

                <CheckBox x:Name="chkDecimalDisplay"
                          Content="Koordinaten mit Punkt anzeigen"/>

            </StackPanel>

        </GroupBox>

        <GroupBox Header="SearchMarker"
                  Grid.Row="1"
                  Margin="0,10,0,0">

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Durchmesser"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <TextBox x:Name="txtMarkerDiameter"
                         Grid.Row="0"
                         Grid.Column="1"
                         Width="100"
                         HorizontalAlignment="Left"
                         Margin="0,5"/>

                <TextBlock Text="Füllfarbe"
                           Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,5">

                    <Border x:Name="borderFillColor"
                            Width="30"
                            Height="20"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="0,0,10,0"/>

                    <Button Content="Auswählen..."
                            Width="100"
                            Click="btnChooseFillColor_Click"/>

                </StackPanel>

                <TextBlock Text="Umrissfarbe"
                           Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,5">

                    <Border x:Name="borderStrokeColor"
                            Width="30"
                            Height="20"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="0,0,10,0"/>

                    <Button Content="Auswählen..."
                            Width="100"
                            Click="btnChooseStrokeColor_Click"/>

                </StackPanel>

                <TextBlock Text="Umrissbreite"
                           Grid.Row="3"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <TextBox x:Name="txtMarkerStrokeThickness"
                         Grid.Row="3"
                         Grid.Column="1"
                         Width="100"
                         HorizontalAlignment="Left"
                         Margin="0,5"/>

            </Grid>

        </GroupBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button x:Name="btnCancel"
                    Width="100"
                    Margin="5"
                    Content="Abbrechen"
                    Click="btnCancel_Click"/>

            <Button x:Name="btnSave"
                    Width="100"
                    Margin="5"
                    Content="Speichern"
                    Click="btnSave_Click"/>

            <Button x:Name="btnSaveClose"
                    Width="160"
                    Margin="5"
                    Content="Speichern + Schließen"
                    Click="btnSaveClose_Click"/>

        </StackPanel>

    </Grid>

</Window>