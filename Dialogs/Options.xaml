<Window x:Class="Dialogs.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optionen"
        Height="220"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Anzeige"
                  Grid.Row="0">

            <StackPanel Margin="10">

                <CheckBox x:Name="chkDecimalDisplay"
                          Content="Koordinaten mit Punkt anzeigen"/>

            </StackPanel>

        </GroupBox>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button x:Name="btnCancel"
                    Width="100"
                    Margin="5"
                    Content="Abbrechen"
                    Click="btnCancel_Click"/>

            <Button x:Name="btnSave"
                    Width="100"
                    Margin="5"
                    Content="Speichern"
                    Click="btnSave_Click"/>

            <Button x:Name="btnSaveClose"
                    Width="160"
                    Margin="5"
                    Content="Speichern + Schließen"
                    Click="btnSaveClose_Click"/>

        </StackPanel>

    </Grid>

</Window>