<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="inoMaps"
        Height="900"
        Width="1400">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">

            <MenuItem Header="_Datei">
                <MenuItem Header="Karte laden"
                  Click="btnLoadMap_Click"/>
                <Separator/>

                <MenuItem Header="Letzte Karten"
                    x:Name="mnuRecentMaps"/>

                <Separator/>
                <MenuItem Header="Beenden"
                  Click="close_Click"/>
            </MenuItem>
            
            <MenuItem Header="Kalibrieren">
                <MenuItem Header="Bild laden"
                  Click="LoadImage_Click"/>
                <MenuItem Header="Kalibrieren"
                  Click="Calibrate_Click"/>
            </MenuItem>

            <MenuItem Header="_Extras">
                <MenuItem Header="Optionen"
              Click="Options_Click"/>
            </MenuItem>
            
            <MenuItem Header="?">
                <MenuItem Header="Info"
                  Click="Info_Click"/>
            </MenuItem>

        </Menu>
        <ToolBar Grid.Row="1">
            <Button Content="+"
                    Width="40"
                    Click="btnZoomIn_Click"/>

            <Button Content="-"
                    Width="40"
                    Click="btnZoomOut_Click"/>

        </ToolBar>

        <ScrollViewer x:Name="MapScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

            <Image Name="MapImage"
                   MouseMove="MapImage_MouseMove"
                   MouseWheel="MapImage_MouseWheel"
                   MouseLeftButtonDown="MapImage_MouseLeftButtonDown"
                   MouseLeftButtonUp="MapImage_MouseLeftButtonUp">

                <Image.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform"/>
                </Image.LayoutTransform>

            </Image>

        </ScrollViewer>

        <Grid Grid.Row="3" Margin="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Suche"
                     Grid.Column="0"
                    Width="40"
                    Margin="5"
                    Click="btnSearch_Click"/>

            <TextBlock Text="Längengrad"
                        Grid.Column="1"
                       VerticalAlignment="Center"/>

            <TextBox Name="txtLongitude"
                     Grid.Column="2"
                     Margin="5"/>

            <TextBlock Text="Breitengrad"
                       Grid.Column="3"
                       VerticalAlignment="Center"/>

            <TextBox Name="txtLatitude"
                     Grid.Column="4"
                     Margin="5"/>

            <TextBlock Text="Ferro"
                       Grid.Column="5"
                       VerticalAlignment="Center"/>

            <TextBox Name="txtFerro"
                     Grid.Column="6"
                     Margin="5"/>
            <TextBox Name="txtPosition"
                     Grid.Column="7"
                     Margin="5"/>
        </Grid>

    </Grid>

</Window>